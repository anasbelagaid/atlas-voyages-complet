          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offre_id\": {{offreId}},\n  \"nom_client\": \"Ahmed Exemple\",\n  \"email\": \"ahmed@example.com\",\n  \"telephone\": \"0612345678\",\n  \"nombre_personnes\": 2,\n  \"date_reservation\": \"2026-11-15\"\n}"
            },
            "url": "{{baseUrl}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Liste des réservations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Contacts",
      "item": [
