            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Sara Exemple\",\n  \"email\": \"sara@example.com\",\n  \"sujet\": \"Séjour à Marrakech\",\n  \"message\": \"Je souhaite recevoir des informations.\"\n}"
            },
            "url": "{{baseUrl}}/contacts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}